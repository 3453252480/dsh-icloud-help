{
  "name": "dsh-icloud-help",
  "version": "0.2.5",
  "description": "iCloud Windows 助手：查看照片库中仅存云端的文件，并一键下载到本地",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "icloud",
    "photos",
    "windows",
    "heic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3453252480/dsh-icloud-help.git"
  },
  "homepage": "https://github.com/3453252480/dsh-icloud-help#readme",
  "bugs": {
    "url": "https://github.com/3453252480/dsh-icloud-help/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
